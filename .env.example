# ==============================================================================
# Health Connect Hub — Master Template Environment Variables
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your Vercel Project Settings > Environment Variables.
# NEVER commit real secrets or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Admin Auth)
# ------------------------------------------------------------------------------
SUPABASE_URL=""                      # e.g. https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""         # Server-side admin key (bypasses RLS; required for bookings, /admin, cron, /manage-booking)
SUPABASE_PUBLISHABLE_KEY=""          # Public anon / publishable key
SUPABASE_PROJECT_ID=""               # Your Supabase project reference ID

# Client-side aliases (optional — server functions use the server vars above)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# ------------------------------------------------------------------------------
# 2. Public App URL & Automated Cron Security (Phase 2 & 3)
# ------------------------------------------------------------------------------
# Public deployment base URL (no trailing slash) — used to build /manage-booking?token=... links
NEXT_PUBLIC_BASE_URL=""              # e.g. https://your-clinic.vercel.app
PUBLIC_BASE_URL=""                   # Optional fallback alias for webhook links

# Secret bearer token used by Vercel Cron to authorize GET /api/cron/reminders
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 3. Google Calendar Integration (Google Cloud Service Account)
# ------------------------------------------------------------------------------
# Setup:
#   1. Create a Google Cloud project & enable the Google Calendar API.
#   2. Create a Service Account (IAM & Admin > Service Accounts) & download JSON key.
#   3. Share the clinic's Google Calendar with GOOGLE_CLIENT_EMAIL ("Make changes to events").
GOOGLE_CLIENT_EMAIL=""               # e.g. booking-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=""                # PEM key with escaped \n (e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n")
GOOGLE_CALENDAR_ID=""                # Clinic Google Calendar ID (e.g. clinic@gmail.com or ...@group.calendar.google.com)

# Optional Google Calendar overrides:
GOOGLE_SERVICE_ACCOUNT_JSON=""       # Optional: full Service Account JSON (raw or base64) instead of separate keys above
GOOGLE_CALENDAR_TIMEZONE="Asia/Nicosia"
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES="60"

# ------------------------------------------------------------------------------
# 4. Resend Email Automation (https://resend.com/api-keys)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""                    # re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional custom From address (defaults to clinic.notifications in src/config/clinic.ts)
RESEND_FROM_EMAIL=""                 # e.g. "Dr. Name <appointments@yourdomain.com>"
# Optional internal recipient for new booking & cancellation alerts (defaults to clinic.ts)
CLINIC_NOTIFICATION_EMAIL=""         # e.g. info@yourclinic.com

# ------------------------------------------------------------------------------
# 5. Twilio Messaging: SMS / WhatsApp / Viber (https://www.twilio.com/)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""                # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=""                 # Your Twilio Auth Token
# Sender identifier: E.164 phone number (+357...) OR Alphanumeric Sender ID (e.g. "appointment")
TWILIO_PHONE_NUMBER=""
# Optional Twilio Messaging Service SID (if using a messaging service pool instead of TWILIO_PHONE_NUMBER)
TWILIO_MESSAGING_SERVICE_SID=""      # MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional multi-channel overrides (falls back automatically to SMS on failure):
TWILIO_WHATSAPP_NUMBER=""            # E.164 WhatsApp-enabled number, e.g. +14155238886
TWILIO_VIBER_SERVICE_SID=""          # VSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional webhook security (validates X-Twilio-Signature HMAC-SHA1 on POST /api/messaging/webhook)
MESSAGING_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. Optional UI Branding Overrides
# ------------------------------------------------------------------------------
# Optional remote URL for the doctor's portrait photo (defaults to src/assets/doctor.jpg)
VITE_DOCTOR_AVATAR_URL=""
