# Supabase Configuration
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Resend Email Automation Configuration
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=""

# Optional custom sender address (defaults to: "{Doctor Name} <onboarding@resend.dev>")
# Note: For production with verified domain, use: "Dr. Elena Markou <appointments@yourdomain.com>"
RESEND_FROM_EMAIL=""

# Optional custom recipient email for new booking alerts (defaults to contact email in clinicConfig.ts)
CLINIC_NOTIFICATION_EMAIL=""

# Google Calendar Integration Configuration
# Setup instructions:
# 1. Create a project in Google Cloud Console & enable the Google Calendar API.
# 2. Create a Service Account (IAM & Admin > Service Accounts) and generate/download a JSON key.
# 3. Share your clinic's Google Calendar with the service account email (permission: "Make changes to events").
# 4. Configure either the individual keys below or the full JSON string:

# Google Service Account email (e.g. "clinic-booking@my-project.iam.gserviceaccount.com")
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# Google Service Account private key in PEM format (e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...-----END PRIVATE KEY-----")
GOOGLE_PRIVATE_KEY=""

# Target Google Calendar ID (e.g. "primary" or your calendar email such as "hello@drmarkou.clinic")
GOOGLE_CALENDAR_ID=""

# Optional: Full Service Account JSON or base64-encoded string (convenient single variable for deployment platforms)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Optional: Timezone for appointments (defaults to "Asia/Nicosia")
GOOGLE_CALENDAR_TIMEZONE="Asia/Nicosia"

# Optional: Default appointment duration in minutes if not specified by service (defaults to 60)
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES="60"

# ------------------------------------------------------------------
# Messaging Notifications: SMS / WhatsApp / Viber via Twilio
# (Optional — messaging is gracefully skipped when TWILIO_ACCOUNT_SID is absent)
# Sign up at https://www.twilio.com/
# ------------------------------------------------------------------

# Required for any Twilio messaging channel:
TWILIO_ACCOUNT_SID=""          # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=""           # Your Twilio Auth Token
TWILIO_FROM_NUMBER=""          # E.164 format, e.g. +35725000000

# Optional — enables WhatsApp channel (number must be Twilio WhatsApp-enabled):
TWILIO_WHATSAPP_NUMBER=""      # E.164, e.g. +14155238886

# Optional — enables Viber channel via a Twilio Viber Service SID:
TWILIO_VIBER_SERVICE_SID=""    # VSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook security: set to your Twilio Auth Token.
# The webhook handler validates X-Twilio-Signature using HMAC-SHA1.
MESSAGING_WEBHOOK_SECRET=""

# Public base URL for your deployment — used to build patient Accept/Cancel links.
# Example: https://drstylianou.clinic
PUBLIC_BASE_URL=""
